---
import "../styles/global.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/inter/900.css";

export interface Props {
  title: string;
  description?: string;
  city?: string;
  noIndex?: boolean;
  schema?: object;
  canonical?: string;
}

const {
  title,
  description = "ProSec Serrurerie — Serrurier agréé assurance à Lyon. Intervention rapide 24h/7j, moins de 30 minutes. Ouverture de porte, blindage, remplacement serrure.",
  noIndex = false,
  schema,
  canonical,
} = Astro.props;

const siteUrl = "https://p4-local-demo.netlify.app";
const canonicalURL = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- OG -->
    <meta property="og:title" content={`${title} | ProSec Serrurerie Lyon`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Schema.org LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocksmithBusiness",
      "name": "ProSec Serrurerie",
      "description": "Serrurier agréé assurance à Lyon — Urgence 24h/7j",
      "telephone": "+33478001122",
      "email": "contact@prosec-serrurerie.fr",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Lyon",
        "postalCode": "69000",
        "addressCountry": "FR"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 45.7640,
        "longitude": 4.8357
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "priceRange": "€€",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.9",
        "reviewCount": "127"
      }
    })} />

    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <title>{title} | ProSec Serrurerie Lyon</title>
  </head>

  <body class="bg-white min-h-screen" style="font-family: 'Inter', system-ui, sans-serif;">
    <slot />
  </body>
</html>
