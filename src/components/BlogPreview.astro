---
const articles = [
  {
    slug: "que-faire-porte-claquee-lyon",
    cat: "Guide urgence",
    catColor: "#00e5ff",
    title: "Porte claquée à Lyon : que faire en urgence ?",
    excerpt: "Vous êtes bloqué devant votre porte à Lyon ? Voici les étapes à suivre pour intervenir rapidement et éviter les arnaques.",
    date: "15 mars 2024",
    readTime: "4 min",
    img: "🔑",
  },
  {
    slug: "bien-choisir-serrure-appartement-lyon",
    cat: "Conseils sécurité",
    catColor: "#10b981",
    title: "Comment choisir sa serrure pour un appartement à Lyon ?",
    excerpt: "Serrure A2P, multipoints, connectée — guide complet pour choisir la serrure adaptée à votre logement lyonnais et à votre assurance.",
    date: "8 mars 2024",
    readTime: "6 min",
    img: "🛡️",
  },
  {
    slug: "blindage-porte-obligatoire-assurance-lyon",
    cat: "Assurance & sécurité",
    catColor: "#0066ff",
    title: "Blindage de porte : est-il obligatoire pour votre assurance habitation ?",
    excerpt: "Certaines assurances exigent un blindage de porte. Découvrez ce que dit votre contrat et comment ProSec vous aide à être conforme.",
    date: "1 mars 2024",
    readTime: "5 min",
    img: "📋",
  },
];
---

<section style="background: #ffffff; padding: 5rem 0;" id="blog">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 mb-10">
      <div>
        <p class="section-label mb-2">Conseils & actualités</p>
        <h2 class="section-title">Blog serrurerie Lyon</h2>
      </div>
      <a
        href="/blog"
        style="display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; font-weight: 600; color: #0066ff; text-decoration: none; flex-shrink: 0;"
      >
        Tous les articles
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    <!-- Articles grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {articles.map((art) => (
        <a
          href={`/blog/${art.slug}`}
          class="card-white group"
          style="text-decoration: none; display: flex; flex-direction: column; border: 1px solid #f1f5f9; transition: transform 0.2s, box-shadow 0.2s; border-radius: 1.25rem; overflow: hidden;"
          onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 12px 40px -8px rgba(0,0,0,0.12)';"
          onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='';"
        >
          <!-- Image/Icon area -->
          <div
            style={`height: 160px; background: linear-gradient(135deg, ${art.catColor}10, ${art.catColor}25); display: flex; align-items: center; justify-content: center; position: relative;`}
          >
            <span style="font-size: 3.5rem;">{art.img}</span>
            <!-- Cat badge -->
            <div
              style={`position: absolute; top: 1rem; left: 1rem; background: ${art.catColor}20; border: 1px solid ${art.catColor}40; color: ${art.catColor}; font-size: 0.75rem; font-weight: 700; padding: 0.25rem 0.75rem; border-radius: 9999px;`}
            >
              {art.cat}
            </div>
          </div>

          <!-- Content -->
          <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column; gap: 0.75rem;">
            <h3 style="font-size: 1rem; font-weight: 700; color: #0a0f1e; line-height: 1.4;">
              {art.title}
            </h3>
            <p style="font-size: 0.875rem; color: #6b7280; line-height: 1.6; flex: 1;">
              {art.excerpt}
            </p>
            <div class="flex items-center justify-between" style="padding-top: 0.5rem; border-top: 1px solid #f1f5f9;">
              <span style="font-size: 0.8125rem; color: #9ca3af;">{art.date}</span>
              <span style="font-size: 0.8125rem; color: #9ca3af;">⏱ {art.readTime}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
