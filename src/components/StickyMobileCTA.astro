---
// Sticky CTA mobile — visible uniquement sur mobile (md:hidden)
---

<div
  class="md:hidden"
  style="position: fixed; bottom: 0; left: 0; right: 0; z-index: 999; display: flex;"
  aria-label="Actions rapides mobile"
>
  <!-- Safe area for iPhone -->
  <div style="width: 100%; display: flex; padding-bottom: env(safe-area-inset-bottom); background: #0a0f1e;">
    <!-- Appeler -->
    <a
      href="tel:0478001122"
      style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem; padding: 0.75rem 0.5rem; background: linear-gradient(135deg, #00e5ff, #0066ff); color: #0a0f1e; font-weight: 800; font-size: 0.9375rem; text-decoration: none; border-right: 1px solid rgba(255,255,255,0.15);"
    >
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
      </svg>
      <span style="font-size: 0.8125rem;">📞 Appeler</span>
    </a>

    <!-- Devis gratuit -->
    <a
      href="/contact"
      style="flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.2rem; padding: 0.75rem 0.5rem; background: #0a0f1e; color: #ffffff; font-weight: 700; font-size: 0.9375rem; text-decoration: none;"
    >
      <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      <span style="font-size: 0.8125rem;">Devis gratuit</span>
    </a>
  </div>
</div>

<!-- Padding bottom pour iOS sticky -->
<div class="md:hidden" style="height: calc(60px + env(safe-area-inset-bottom));"></div>
