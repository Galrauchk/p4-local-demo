---
export interface Props {
  currentPage?: string;
}
const { currentPage = "" } = Astro.props;

const navLinks = [
  { href: "/", label: "Accueil" },
  {
    href: "#services",
    label: "Services",
    dropdown: [
      { href: "/services/ouverture-porte", label: "Ouverture de porte" },
      { href: "/services/remplacement-serrure", label: "Remplacement serrure" },
      { href: "/services/blindage", label: "Blindage de porte" },
      { href: "/services/coffre-fort", label: "Coffre-fort" },
      { href: "/services/controle-acces", label: "Contrôle d'accès" },
      { href: "/services/vitrage-urgence", label: "Vitrage urgence" },
    ],
  },
  { href: "/lyon", label: "Lyon" },
  { href: "/villeurbanne", label: "Villeurbanne" },
  { href: "/caluire", label: "Caluire" },
  { href: "/blog", label: "Blog" },
  { href: "/contact", label: "Contact" },
];
---

<header
  id="site-header"
  style="background: #ffffff; position: sticky; top: 0; z-index: 90; border-bottom: 1px solid #f1f5f9;"
  class="transition-shadow duration-300"
>
  <!-- Barre disponibilité -->
  <div
    style="background: rgba(16,185,129,0.08); border-bottom: 1px solid rgba(16,185,129,0.15); padding: 0.375rem 1rem;"
    class="hidden md:flex items-center justify-center gap-2"
  >
    <span class="dot-pulse"></span>
    <span style="font-size: 0.8125rem; font-weight: 600; color: #059669;">
      Disponible maintenant · Intervention en moins de 30 min sur Lyon et le Grand Lyon
    </span>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 flex-shrink-0">
      <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="36" height="36" rx="8" fill="#0a0f1e"/>
        <!-- Clé SVG -->
        <circle cx="13" cy="15" r="5.5" stroke="#00e5ff" stroke-width="2.5" fill="none"/>
        <path d="M17 19 L26 28" stroke="#00e5ff" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M23 25 L25 23" stroke="#00e5ff" stroke-width="2" stroke-linecap="round"/>
        <path d="M21 27 L23 25" stroke="#00e5ff" stroke-width="2" stroke-linecap="round"/>
        <circle cx="13" cy="15" r="2" fill="#00e5ff"/>
      </svg>
      <div>
        <div style="font-size: 1.125rem; font-weight: 800; color: #0a0f1e; line-height: 1.1;">ProSec</div>
        <div style="font-size: 0.6875rem; font-weight: 500; color: #6b7280; line-height: 1; letter-spacing: 0.03em;">SERRURERIE · LYON</div>
      </div>
    </a>

    <!-- Nav desktop -->
    <nav class="hidden lg:flex items-center gap-6">
      {navLinks.map((link) => (
        <div class="relative group">
          <a
            href={link.href}
            class={`nav-link py-1 ${currentPage === link.href ? "active" : ""}`}
          >
            {link.label}
            {link.dropdown && (
              <svg class="inline-block ml-0.5 mb-0.5 w-3.5 h-3.5 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>
          {link.dropdown && (
            <div
              class="absolute top-full left-0 pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200"
              style="z-index: 200;"
            >
              <div class="card-white py-2 min-w-52" style="border: 1px solid #f1f5f9;">
                {link.dropdown.map((item) => (
                  <a
                    href={item.href}
                    style="display: flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1rem; font-size: 0.875rem; font-weight: 500; color: #374151; transition: all 0.15s; white-space: nowrap;"
                    onmouseover="this.style.background='#f8fafc'; this.style.color='#0066ff';"
                    onmouseout="this.style.background=''; this.style.color='#374151';"
                  >
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: #00e5ff; flex-shrink: 0;">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                    </svg>
                    {item.label}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Phone CTA -->
    <div class="flex items-center gap-3">
      <a
        href="tel:0478001122"
        class="btn-cta hidden sm:inline-flex text-sm"
        style="padding: 0.625rem 1.25rem; font-size: 0.875rem;"
      >
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
        </svg>
        04 78 00 11 22
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2"
        aria-label="Menu"
        style="color: #0a0f1e;"
      >
        <span class="block w-5 h-0.5 bg-current transition-all" id="bar1"></span>
        <span class="block w-5 h-0.5 bg-current transition-all" id="bar2"></span>
        <span class="block w-5 h-0.5 bg-current transition-all" id="bar3"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-nav" class="lg:hidden hidden border-t" style="border-color: #f1f5f9; background: #ffffff;">
    <div class="px-4 py-4 flex flex-col gap-1">
      {navLinks.map((link) => (
        <div>
          <a
            href={link.href}
            style="display: block; padding: 0.625rem 0.5rem; font-size: 0.9375rem; font-weight: 500; color: #374151; border-radius: 0.5rem; transition: all 0.15s;"
            onmouseover="this.style.background='#f8fafc'; this.style.color='#0066ff';"
            onmouseout="this.style.background=''; this.style.color='#374151';"
          >
            {link.label}
          </a>
          {link.dropdown && (
            <div class="pl-4 flex flex-col gap-0.5 mt-1">
              {link.dropdown.map((item) => (
                <a
                  href={item.href}
                  style="display: block; padding: 0.5rem 0.5rem; font-size: 0.875rem; color: #6b7280; transition: color 0.15s;"
                >
                  → {item.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <a
        href="tel:0478001122"
        class="btn-cta mt-3 justify-center"
        style="font-size: 0.9375rem;"
      >
        📞 04 78 00 11 22 — Urgence
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    nav?.classList.toggle("hidden");
  });

  // Scroll shadow
  const header = document.getElementById("site-header");
  window.addEventListener("scroll", () => {
    if (window.scrollY > 10) {
      header?.style.setProperty("box-shadow", "0 4px 24px -4px rgba(0,0,0,0.12)");
    } else {
      header?.style.setProperty("box-shadow", "none");
    }
  });
</script>
