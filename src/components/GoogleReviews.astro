---
// Widget Google Reviews simulé — style Google Business
const reviews = [
  {
    name: "Marie-Claire D.",
    initials: "MD",
    color: "#0066ff",
    date: "Il y a 2 jours",
    stars: 5,
    text: "Serrurier très professionnel ! Ma porte claquée a été ouverte en 20 minutes sans aucun dégât. Prix conforme au devis, je recommande vivement ProSec pour toute urgence serrurerie à Lyon.",
  },
  {
    name: "Thomas R.",
    initials: "TR",
    color: "#10b981",
    date: "Il y a 1 semaine",
    stars: 5,
    text: "Intervention rapide pour un remplacement de serrure multipoints. Technicien compétent, matériel de qualité. L'assurance a tout remboursé car agréé. Parfait du début à la fin.",
  },
  {
    name: "Sandrine B.",
    initials: "SB",
    color: "#f59e0b",
    date: "Il y a 2 semaines",
    stars: 5,
    text: "Blindage de porte réalisé impeccablement à Villeurbanne. Le technicien a pris le temps d'expliquer toutes les options. Résultat très solide, je me sens enfin en sécurité. Merci !",
  },
];
---

<section style="background: #f8fafc; padding: 5rem 0;" id="avis">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-10">
      <div>
        <p class="section-label mb-2">Ce que disent nos clients</p>
        <h2 class="section-title">Avis clients vérifiés</h2>
      </div>

      <!-- Widget Google Business -->
      <div
        style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 1.25rem; padding: 1.25rem 1.5rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; box-shadow: 0 2px 12px -2px rgba(0,0,0,0.06); flex-shrink: 0; min-width: 220px;"
      >
        <!-- Logo Google -->
        <div class="flex items-center gap-2">
          <svg width="24" height="24" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span style="font-size: 0.875rem; font-weight: 600; color: #374151;">Google</span>
        </div>
        <div style="display: flex; align-items: baseline; gap: 0.5rem;">
          <span style="font-size: 2rem; font-weight: 900; color: #0a0f1e; line-height: 1;">4.9</span>
          <div>
            <div class="stars">★★★★★</div>
            <div style="font-size: 0.75rem; color: #6b7280;">127 avis</div>
          </div>
        </div>
        <a
          href="https://www.google.com/maps"
          target="_blank"
          rel="noopener noreferrer"
          style="font-size: 0.8125rem; font-weight: 600; color: #0066ff; text-decoration: underline; text-underline-offset: 3px;"
        >
          Voir sur Google Maps →
        </a>
      </div>
    </div>

    <!-- Grid des 3 avis -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <div
          class="card-white"
          style="padding: 1.75rem; border: 1px solid #f1f5f9; display: flex; flex-direction: column; gap: 1rem;"
        >
          <!-- En-tête -->
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <!-- Avatar lettres -->
              <div
                style={`width: 44px; height: 44px; border-radius: 50%; background: ${review.color}; display: flex; align-items: center; justify-content: center; font-size: 0.875rem; font-weight: 700; color: #ffffff; flex-shrink: 0;`}
              >
                {review.initials}
              </div>
              <div>
                <p style="font-size: 0.9375rem; font-weight: 600; color: #0a0f1e;">{review.name}</p>
                <p style="font-size: 0.8125rem; color: #9ca3af;">{review.date}</p>
              </div>
            </div>
            <!-- Google icon mini -->
            <svg width="16" height="16" viewBox="0 0 24 24" style="flex-shrink: 0; margin-top: 4px;">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
          </div>

          <!-- Étoiles -->
          <div class="stars" style="font-size: 1rem;">
            {"★".repeat(review.stars)}
          </div>

          <!-- Texte -->
          <p style="font-size: 0.9rem; color: #4b5563; line-height: 1.7; flex: 1;">
            "{review.text}"
          </p>

          <!-- Lien -->
          <a
            href="https://www.google.com/maps"
            target="_blank"
            rel="noopener noreferrer"
            style="font-size: 0.8125rem; font-weight: 600; color: #0066ff; display: flex; align-items: center; gap: 0.25rem; text-decoration: none; transition: gap 0.15s;"
          >
            Voir sur Google
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Badge satisfaction -->
    <div class="flex justify-center mt-10">
      <div
        style="display: inline-flex; align-items: center; gap: 1rem; background: #ffffff; border: 1px solid #e5e7eb; border-radius: 9999px; padding: 0.75rem 2rem; box-shadow: 0 2px 12px -2px rgba(0,0,0,0.06);"
      >
        <span style="font-size: 1.5rem;">🏆</span>
        <div>
          <p style="font-size: 0.9375rem; font-weight: 700; color: #0a0f1e;">98% de clients satisfaits</p>
          <p style="font-size: 0.8125rem; color: #6b7280;">Basé sur 127 avis Google vérifiés</p>
        </div>
      </div>
    </div>

  </div>
</section>
