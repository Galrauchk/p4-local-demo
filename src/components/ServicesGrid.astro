---
const services = [
  {
    slug: "ouverture-porte",
    icon: "🔓",
    title: "Ouverture de porte",
    desc: "Clé cassée, porte claquée, serrure bloquée ? Nous intervenons en urgence sur tous types de serrures, sans dommage.",
    prix: "Dès 69€",
    tags: ["Urgence 24h", "Sans dégâts"],
    color: "#00e5ff",
  },
  {
    slug: "remplacement-serrure",
    icon: "🔧",
    title: "Remplacement de serrure",
    desc: "Installation de serrures A2P, multipoints, haute sécurité. Remplacez votre ancienne serrure par un modèle certifié.",
    prix: "Dès 89€",
    tags: ["Certifié A2P", "Garantie 2 ans"],
    color: "#0066ff",
  },
  {
    slug: "blindage",
    icon: "🛡️",
    title: "Blindage de porte",
    desc: "Renforcez votre porte d'entrée avec un blindage acier. Protection anti-effraction maximale, finitions au choix.",
    prix: "Sur devis",
    tags: ["Anti-effraction", "Agréé assurance"],
    color: "#10b981",
  },
  {
    slug: "coffre-fort",
    icon: "🏛️",
    title: "Coffre-fort",
    desc: "Installation, ouverture et dépannage de coffres-forts. Toutes marques, tous modèles, pour particuliers et entreprises.",
    prix: "Dès 120€",
    tags: ["Tous modèles", "Pro & Particulier"],
    color: "#00e5ff",
  },
  {
    slug: "controle-acces",
    icon: "📲",
    title: "Contrôle d'accès",
    desc: "Digicodes, badges, interphones, accès biométrique. Sécurisez votre immeuble ou entreprise avec les dernières technologies.",
    prix: "Sur devis",
    tags: ["Immeuble", "Entreprise"],
    color: "#0066ff",
  },
  {
    slug: "vitrage-urgence",
    icon: "🪟",
    title: "Vitrage urgence",
    desc: "Bris de glace, fenêtre cassée, porte vitrée brisée ? Remplacement immédiat de vitres et vitrages sécurisés.",
    prix: "Dès 79€",
    tags: ["Urgence 24h", "Bris de glace"],
    color: "#10b981",
  },
];
---

<section style="background: #f8fafc; padding: 5rem 0;" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-12">
      <p class="section-label mb-2">Ce que nous faisons</p>
      <h2 class="section-title mb-4">Nos services de serrurerie</h2>
      <p class="section-sub mx-auto text-center">
        Serrurier agréé assurance à Lyon — Tous nos services sont garantis, avec devis transparent avant intervention.
      </p>
    </div>

    <!-- Grid services -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((svc) => (
        <a
          href={`/services/${svc.slug}`}
          class="service-card card-white group"
          style={`border: 1px solid rgba(0,0,0,0.05); text-decoration: none; display: block;`}
        >
          <!-- Image placeholder with gradient -->
          <div
            style={`height: 180px; background: linear-gradient(135deg, ${svc.color}18, ${svc.color}30); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden;`}
          >
            <span style="font-size: 4rem;">{svc.icon}</span>
            <!-- Overlay gradient on hover -->
            <div
              style={`position: absolute; inset: 0; background: linear-gradient(135deg, ${svc.color}10, transparent); opacity: 0; transition: opacity 0.3s;`}
              class="group-hover:opacity-100"
            ></div>
          </div>

          <!-- Content -->
          <div style="padding: 1.5rem;">
            <div class="flex items-center justify-between mb-2">
              <h3 style="font-size: 1.0625rem; font-weight: 700; color: #0a0f1e;">{svc.title}</h3>
              <span
                style={`font-size: 0.8125rem; font-weight: 700; color: ${svc.color}; background: ${svc.color}15; padding: 0.25rem 0.625rem; border-radius: 9999px; white-space: nowrap;`}
              >
                {svc.prix}
              </span>
            </div>

            <p style="font-size: 0.875rem; color: #6b7280; line-height: 1.6; margin-bottom: 1rem;">
              {svc.desc}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-3">
              {svc.tags.map((tag) => (
                <span class="tag tag-cyan" style={`background: ${svc.color}12; color: ${svc.color}; border-color: ${svc.color}30;`}>{tag}</span>
              ))}
            </div>

            <div
              style={`display: flex; align-items: center; gap: 0.375rem; font-size: 0.875rem; font-weight: 600; color: ${svc.color}; transition: gap 0.2s;`}
              class="group-hover:gap-2"
            >
              En savoir plus
              <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA bas -->
    <div class="text-center mt-12">
      <div style="display: inline-flex; flex-direction: column; align-items: center; gap: 1rem;">
        <p style="font-size: 0.9375rem; color: #6b7280;">Besoin d'un service en urgence ?</p>
        <a href="tel:0478001122" class="btn-cta">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
          </svg>
          Appeler maintenant — 04 78 00 11 22
        </a>
      </div>
    </div>

  </div>
</section>
