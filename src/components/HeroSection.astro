---
export interface Props {
  title?: string;
  subtitle?: string;
  showStats?: boolean;
}

const {
  title = "Serrurier agréé Lyon\nIntervention rapide — Urgence 24h/7j",
  subtitle = "Ouverture de porte · Blindage · Remplacement serrure · Contrôle d'accès\nLyon 1er–9ème, Villeurbanne, Caluire et tout le Grand Lyon",
  showStats = true,
} = Astro.props;
---

<section
  style="position: relative; min-height: 90vh; display: flex; flex-direction: column; justify-content: center; overflow: hidden;"
>
  <!-- Background image -->
  <div
    style="position: absolute; inset: 0; background-image: url('https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600&q=80'); background-size: cover; background-position: center; background-repeat: no-repeat;"
  ></div>

  <!-- Overlay navy 65% -->
  <div
    style="position: absolute; inset: 0; background: linear-gradient(135deg, rgba(10,15,30,0.82) 0%, rgba(10,15,30,0.62) 60%, rgba(10,15,30,0.75) 100%);"
  ></div>

  <!-- Grid pattern overlay -->
  <div
    style="position: absolute; inset: 0; background-image: repeating-linear-gradient(0deg, rgba(0,229,255,0.03) 0px, rgba(0,229,255,0.03) 1px, transparent 1px, transparent 80px), repeating-linear-gradient(90deg, rgba(0,229,255,0.03) 0px, rgba(0,229,255,0.03) 1px, transparent 1px, transparent 80px);"
  ></div>

  <!-- Content -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 flex flex-col items-center text-center">

    <!-- Badge pulsé -->
    <div class="badge-live mb-6 animate-fade-in-up">
      <span class="dot-pulse"></span>
      <span>Disponible · Intervention sous 30 min à Lyon</span>
    </div>

    <!-- H1 -->
    <h1
      style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; color: #ffffff; line-height: 1.1; margin-bottom: 1.25rem; max-width: 52rem; white-space: pre-line;"
      class="animate-fade-in-up"
    >
      {title}
    </h1>

    <!-- Sous-titre -->
    <p
      style="font-size: clamp(1rem, 2vw, 1.1875rem); color: rgba(255,255,255,0.78); line-height: 1.6; margin-bottom: 2.5rem; max-width: 40rem; white-space: pre-line;"
      class="animate-fade-in-up"
    >
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 items-center mb-10 animate-fade-in-up">
      <a
        href="tel:0478001122"
        class="btn-cta text-base"
        style="padding: 1rem 2.25rem; font-size: 1.0625rem;"
      >
        <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
        </svg>
        🔑 04 78 00 11 22 — Urgence
      </a>
      <a href="/contact" class="btn-outline text-base">
        Devis gratuit en ligne
      </a>
    </div>

    <!-- Badges confiance -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 animate-fade-in-up">
      {[
        { icon: "🏅", text: "Agréé assurance" },
        { icon: "✅", text: "Devis gratuit" },
        { icon: "⚡", text: "Intervention −30 min" },
        { icon: "📜", text: "Norme NF P 25-311" },
      ].map((badge) => (
        <div
          style="display: flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); padding: 0.5rem 1.125rem; border-radius: 9999px; backdrop-filter: blur(8px);"
        >
          <span>{badge.icon}</span>
          <span style="font-size: 0.875rem; font-weight: 600; color: #ffffff;">{badge.text}</span>
        </div>
      ))}
    </div>

    <!-- Stats bar -->
    {showStats && (
      <div
        style="width: 100%; max-width: 56rem; background: rgba(255,255,255,0.06); border: 1px solid rgba(0,229,255,0.2); border-radius: 1.5rem; padding: 1.25rem 2rem; backdrop-filter: blur(12px);"
        class="animate-fade-in-up"
      >
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {[
            { n: "+1 000", l: "Interventions", sub: "à Lyon" },
            { n: "9", l: "Arrondissements", sub: "couverts" },
            { n: "4.9★", l: "Note Google", sub: "127 avis" },
            { n: "24h/7j", l: "Disponibilité", sub: "garantie" },
          ].map((s) => (
            <div class="text-center">
              <div style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 900; color: #00e5ff; line-height: 1;">{s.n}</div>
              <div style="font-size: 0.875rem; font-weight: 600; color: #ffffff; margin-top: 0.25rem;">{s.l}</div>
              <div style="font-size: 0.75rem; color: rgba(255,255,255,0.5);">{s.sub}</div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-1"
    style="color: rgba(255,255,255,0.4);"
  >
    <span style="font-size: 0.75rem;">Découvrir</span>
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="animation: bounce 2s infinite;">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>

<style>
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.7s ease-out forwards;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
