---
import LegalLinks from "./LegalLinks.astro";

const zones = [
  "Lyon 1er", "Lyon 2ème", "Lyon 3ème",
  "Lyon 4ème", "Lyon 5ème", "Lyon 6ème",
  "Lyon 7ème", "Lyon 8ème", "Lyon 9ème",
  "Villeurbanne", "Caluire-et-Cuire", "Bron",
  "Vénissieux", "Saint-Priest", "Décines",
  "Meyzieu", "Oullins", "Saint-Genis-Laval",
];

const services = [
  { href: "/services/ouverture-porte", label: "Ouverture de porte" },
  { href: "/services/remplacement-serrure", label: "Remplacement de serrure" },
  { href: "/services/blindage", label: "Blindage de porte" },
  { href: "/services/coffre-fort", label: "Coffre-fort" },
  { href: "/services/controle-acces", label: "Contrôle d'accès" },
  { href: "/services/vitrage-urgence", label: "Vitrage d'urgence" },
];

const horaires = [
  { j: "Lun–Ven", h: "24h/24" },
  { j: "Samedi", h: "24h/24" },
  { j: "Dimanche", h: "24h/24" },
  { j: "Jours fériés", h: "24h/24" },
];
---

<footer style="background: #0a0f1e; color: rgba(255,255,255,0.85);">

  <!-- Top Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Colonne 1 : Brand -->
      <div class="lg:col-span-1">
        <div class="flex items-center gap-3 mb-5">
          <svg width="40" height="40" viewBox="0 0 36 36" fill="none">
            <rect width="36" height="36" rx="8" fill="rgba(0,229,255,0.12)" stroke="rgba(0,229,255,0.3)" stroke-width="1"/>
            <circle cx="13" cy="15" r="5.5" stroke="#00e5ff" stroke-width="2.5" fill="none"/>
            <path d="M17 19 L26 28" stroke="#00e5ff" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M23 25 L25 23" stroke="#00e5ff" stroke-width="2" stroke-linecap="round"/>
            <path d="M21 27 L23 25" stroke="#00e5ff" stroke-width="2" stroke-linecap="round"/>
            <circle cx="13" cy="15" r="2" fill="#00e5ff"/>
          </svg>
          <div>
            <div style="font-size: 1.25rem; font-weight: 800; color: #ffffff;">ProSec</div>
            <div style="font-size: 0.75rem; color: rgba(255,255,255,0.5); letter-spacing: 0.05em;">SERRURERIE · LYON</div>
          </div>
        </div>
        <p style="font-size: 0.9rem; line-height: 1.7; color: rgba(255,255,255,0.6); margin-bottom: 1.25rem;">
          Votre serrurier agréé assurance à Lyon et dans le Grand Lyon. Disponible 24h/7j, intervention garantie en moins de 30 minutes.
        </p>
        <div class="flex flex-col gap-2.5">
          <a href="tel:0478001122" style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1.0625rem; color: #00e5ff; transition: color 0.15s;">
            <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
            </svg>
            04 78 00 11 22
          </a>
          <a href="/contact" style="font-size: 0.875rem; color: rgba(255,255,255,0.55); transition: color 0.15s;">
            contact@prosec-serrurerie.fr
          </a>
          <span style="font-size: 0.875rem; color: rgba(255,255,255,0.55);">Lyon, 69000</span>
        </div>
      </div>

      <!-- Colonne 2 : Services -->
      <div>
        <h3 style="font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00e5ff; margin-bottom: 1.25rem;">
          Nos services
        </h3>
        <ul class="flex flex-col gap-2.5">
          {services.map((s) => (
            <li>
              <a
                href={s.href}
                style="font-size: 0.9rem; color: rgba(255,255,255,0.65); transition: color 0.15s; display: flex; align-items: center; gap: 0.5rem;"
                onmouseover="this.style.color='#ffffff';"
                onmouseout="this.style.color='rgba(255,255,255,0.65)';"
              >
                <span style="color: #00e5ff; font-size: 0.7rem;">▶</span>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Colonne 3 : Zones -->
      <div>
        <h3 style="font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00e5ff; margin-bottom: 1.25rem;">
          Zones d'intervention
        </h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {zones.map((z) => (
            <span style="font-size: 0.8rem; background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.65); padding: 0.25rem 0.625rem; border-radius: 9999px; border: 1px solid rgba(255,255,255,0.08);">
              {z}
            </span>
          ))}
        </div>
      </div>

      <!-- Colonne 4 : Horaires + Plan -->
      <div>
        <h3 style="font-size: 0.8125rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #00e5ff; margin-bottom: 1.25rem;">
          Disponibilité
        </h3>
        <div class="flex flex-col gap-2 mb-6">
          {horaires.map((h) => (
            <div class="flex justify-between items-center">
              <span style="font-size: 0.875rem; color: rgba(255,255,255,0.6);">{h.j}</span>
              <span style="font-size: 0.875rem; font-weight: 600; color: #10b981; background: rgba(16,185,129,0.1); padding: 0.125rem 0.625rem; border-radius: 9999px; border: 1px solid rgba(16,185,129,0.25);">
                {h.h}
              </span>
            </div>
          ))}
        </div>

        <!-- Mini map embed -->
        <div style="border-radius: 0.75rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.1);">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d45207.29!2d4.8357!3d45.7640!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f4ea516ae922e1%3A0x408ab2ae4bb21f0!2sLyon!5e0!3m2!1sfr!2sfr!4v1"
            width="100%"
            height="140"
            style="border: none; display: block; filter: grayscale(80%) invert(90%);"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid rgba(255,255,255,0.08);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p style="font-size: 0.8125rem; color: rgba(255,255,255,0.4);">
        © 2024 ProSec Serrurerie. Tous droits réservés.
      </p>
      <div class="flex items-center gap-4">
        <a href="/mentions-legales" style="font-size: 0.8125rem; color: rgba(255,255,255,0.4); transition: color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.8)';" onmouseout="this.style.color='rgba(255,255,255,0.4)';">
          Mentions légales
        </a>
        <span style="color: rgba(255,255,255,0.2);">·</span>
        <a href="/cgv" style="font-size: 0.8125rem; color: rgba(255,255,255,0.4); transition: color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.8)';" onmouseout="this.style.color='rgba(255,255,255,0.4)';">
          CGV
        </a>
        <span style="color: rgba(255,255,255,0.2);">·</span>
        <a href="/a-propos" style="font-size: 0.8125rem; color: rgba(255,255,255,0.4); transition: color 0.15s;" onmouseover="this.style.color='rgba(255,255,255,0.8)';" onmouseout="this.style.color='rgba(255,255,255,0.4)';">
          À propos
        </a>
      </div>
      <LegalLinks includeMentions={false} />
    </div>
  </div>
  <p data-webtrafic-credit style="margin: 1rem; text-align: center; font-size: 0.75rem; line-height: 1.6;">
    Site réalisé par <a href="https://webtrafic.fr/" style="color: inherit; text-decoration: underline; text-underline-offset: 0.2em;">WebTrafic</a>
  </p>
</footer>
