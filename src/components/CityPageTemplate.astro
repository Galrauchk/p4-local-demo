---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "./TopBar.astro";
import Header from "./Header.astro";
import UrgenceBanner from "./UrgenceBanner.astro";
import Footer from "./Footer.astro";
import StickyMobileCTA from "./StickyMobileCTA.astro";

export interface Props {
  city: string;
  postal: string;
  title: string;
  description: string;
  lat: number;
  lng: number;
  hero_sub: string;
  intro: string;
  quartiers: string[];
  services_dispo: string[];
  time: string;
  faqs: Array<{ q: string; a: string }>;
}

const {
  city,
  postal,
  title,
  description,
  lat,
  lng,
  hero_sub,
  intro,
  quartiers,
  services_dispo,
  time,
  faqs,
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocksmithBusiness",
    "name": `ProSec Serrurerie — Serrurier ${city}`,
    "telephone": "+33478001122",
    "email": "contact@prosec-serrurerie.fr",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": city,
      "postalCode": postal,
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": lat,
      "longitude": lng
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    },
    "priceRange": "€€",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "127"
    }
  })} />

  <TopBar />
  <Header />
  <main>

    <!-- Hero ville -->
    <section style="background: linear-gradient(135deg, #0a0f1e 0%, #141c35 100%); padding: 5rem 0; position: relative; overflow: hidden;">
      <div style="position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, rgba(0,229,255,0.02) 0px, rgba(0,229,255,0.02) 1px, transparent 1px, transparent 40px);"></div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="badge-live inline-flex mb-6">
          <span class="dot-pulse"></span>
          <span>Disponible · Intervention sous {time} à {city}</span>
        </div>
        <h1 style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #ffffff; line-height: 1.1; margin-bottom: 1.25rem;">
          Serrurier {city} — Urgence 24h/7j
        </h1>
        <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); line-height: 1.6; max-width: 38rem; margin: 0 auto 2.5rem;">
          {hero_sub}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="tel:0478001122" class="btn-cta" style="font-size: 1.0625rem; padding: 1rem 2.25rem;">
            📞 04 78 00 11 22 — Urgence
          </a>
          <a href="/contact" class="btn-outline">Devis gratuit en ligne</a>
        </div>
      </div>
    </section>

    <!-- Contenu ville -->
    <section style="background: #ffffff; padding: 4rem 0;">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- Texte principal -->
          <div class="lg:col-span-2">
            <p class="section-label mb-2">Votre serrurier local</p>
            <h2 class="section-title mb-5">ProSec Serrurerie à {city}</h2>
            <div style="font-size: 0.9375rem; color: #4b5563; line-height: 1.8;" set:html={intro} />

            <!-- Quartiers -->
            <h3 style="font-size: 1.125rem; font-weight: 700; color: #0a0f1e; margin-top: 2rem; margin-bottom: 1rem;">
              Quartiers et secteurs couverts à {city}
            </h3>
            <div style="display: flex; flex-wrap: gap; gap: 0.5rem;">
              {quartiers.map((q) => (
                <span style="display: inline-block; background: rgba(0,229,255,0.08); border: 1px solid rgba(0,229,255,0.2); color: #0066ff; font-size: 0.8125rem; font-weight: 600; padding: 0.375rem 0.875rem; border-radius: 9999px; margin: 0 0.25rem 0.25rem 0;">
                  {q}
                </span>
              ))}
            </div>
          </div>

          <!-- Sidebar -->
          <div class="flex flex-col gap-5">
            <!-- Carte Maps -->
            <div style="border-radius: 1.25rem; overflow: hidden; border: 1px solid #e5e7eb;">
              <iframe
                src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d20000!2d${lng}!3d${lat}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2s${encodeURIComponent(city)}!5e0!3m2!1sfr!2sfr!4v1`}
                width="100%"
                height="200"
                style="border: none; display: block;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>

            <!-- Intervention -->
            <div style="background: linear-gradient(135deg, rgba(0,229,255,0.06), rgba(0,102,255,0.06)); border: 1px solid rgba(0,229,255,0.2); border-radius: 1.25rem; padding: 1.5rem;">
              <p style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #00e5ff; margin-bottom: 0.75rem;">
                Intervention à {city}
              </p>
              <div class="flex items-center gap-2 mb-2">
                <span class="dot-pulse"></span>
                <span style="font-size: 0.875rem; font-weight: 600; color: #10b981;">Disponible maintenant</span>
              </div>
              <p style="font-size: 1.25rem; font-weight: 900; color: #0a0f1e; margin-bottom: 0.25rem;">−{time} garanti</p>
              <p style="font-size: 0.8rem; color: #6b7280; margin-bottom: 1.25rem;">Délai de trajet depuis Lyon</p>
              <a href="tel:0478001122" class="btn-cta" style="display: block; text-align: center; text-decoration: none; padding: 0.75rem; font-size: 0.9375rem;">
                Appeler maintenant
              </a>
            </div>

            <!-- Services -->
            <div class="card-white" style="border: 1px solid #f1f5f9; padding: 1.25rem;">
              <p style="font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280; margin-bottom: 0.75rem;">
                Services disponibles
              </p>
              <ul class="flex flex-col gap-2">
                {services_dispo.map((s) => (
                  <li style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: #374151;">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="#10b981" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                    {s}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <UrgenceBanner />

    <!-- FAQ locale -->
    <section style="background: #f8fafc; padding: 4rem 0;">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="section-label mb-2 text-center">Questions fréquentes</p>
        <h2 class="section-title mb-10 text-center">FAQ Serrurier {city}</h2>
        <div class="flex flex-col gap-4">
          {faqs.map((faq) => (
            <details style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 1rem; overflow: hidden;">
              <summary style="padding: 1.25rem 1.5rem; font-size: 1rem; font-weight: 600; color: #0a0f1e; display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none;">
                {faq.q}
                <svg class="chevron w-5 h-5 flex-shrink-0 ml-4" style="color: #00e5ff;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div style="padding: 0 1.5rem 1.25rem; font-size: 0.9375rem; color: #4b5563; line-height: 1.7;">{faq.a}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <StickyMobileCTA />
</BaseLayout>
