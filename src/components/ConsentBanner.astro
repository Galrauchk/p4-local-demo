---
import PackageConsentBanner from "../lib/consent/ConsentBanner.astro";
const rawGtmId = import.meta.env.PUBLIC_GTM_ID?.trim() ?? "";
const analyticsEnabled = /^GTM-[A-Z0-9]+$/i.test(rawGtmId);
---
<PackageConsentBanner presentation="panel" analyticsEnabled={analyticsEnabled} theme={{"bg": "#0f172a", "color": "#f8fafc", "colorMuted": "#cbd5e1", "accent": "#38bdf8", "btnBg": "#38bdf8", "btnColor": "#0f172a", "border": "rgba(255,255,255,0.2)", "modalBg": "#172033"}} texts={{ title: "Cookies et confidentialité", cookieLink: "/politique-cookies", privacyLink: "/politique-confidentialite", privacyLabel: "Confidentialité" }} />
