---
// Section Zones d'intervention — fond navy + SVG carte Lyon + grid glassmorphism
const zones = [
  {
    name: "Lyon 1er–3ème",
    time: "–20 min",
    services: ["Ouverture", "Blindage", "Urgence"],
    color: "#00e5ff",
  },
  {
    name: "Lyon 4ème–6ème",
    time: "–20 min",
    services: ["Ouverture", "Serrure", "Urgence"],
    color: "#00e5ff",
  },
  {
    name: "Lyon 7ème–9ème",
    time: "–25 min",
    services: ["Ouverture", "Blindage", "Serrure"],
    color: "#0066ff",
  },
  {
    name: "Villeurbanne",
    time: "–25 min",
    services: ["Ouverture", "Contrôle accès", "Urgence"],
    color: "#0066ff",
  },
  {
    name: "Caluire-et-Cuire",
    time: "–30 min",
    services: ["Ouverture", "Serrure", "Vitrage"],
    color: "#10b981",
  },
  {
    name: "Bron · Vénissieux",
    time: "–30 min",
    services: ["Ouverture", "Blindage", "Serrure"],
    color: "#10b981",
  },
];
---

<section style="background: #0a0f1e; padding: 5rem 0;" id="zones">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-12">
      <p class="section-label mb-2">Couverture géographique</p>
      <h2 class="section-title-white mb-4">Zones d'intervention Grand Lyon</h2>
      <p style="font-size: 1.0625rem; color: rgba(255,255,255,0.55); max-width: 40rem; margin: 0 auto;">
        ProSec intervient dans tous les arrondissements de Lyon et les communes du Grand Lyon.
        Temps de trajet garanti ou intervention gratuite.
      </p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12 items-start">

      <!-- SVG Carte Lyon -->
      <div class="lg:w-96 flex-shrink-0 mx-auto lg:mx-0">
        <div
          style="background: rgba(255,255,255,0.03); border: 1px solid rgba(0,229,255,0.15); border-radius: 1.5rem; padding: 1.5rem;"
        >
          <p style="font-size: 0.8125rem; font-weight: 600; color: rgba(255,255,255,0.5); text-align: center; margin-bottom: 1rem; letter-spacing: 0.05em; text-transform: uppercase;">
            Grand Lyon — Zones d'intervention
          </p>
          <!-- Carte SVG simplifiée de Lyon (9 arrondissements + communes) -->
          <svg
            viewBox="0 0 320 380"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            style="width: 100%; max-width: 280px; margin: 0 auto; display: block;"
          >
            <!-- Arrondissement 9 (NW) -->
            <polygon
              class="arr-path"
              points="30,40 95,30 100,90 65,100 30,80"
              fill="#00e5ff22"
              data-arr="9"
            />
            <text x="58" y="68" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">9e</text>

            <!-- Arrondissement 4 (N) -->
            <polygon
              class="arr-path"
              points="95,30 165,25 170,85 130,100 100,90"
              fill="#00e5ff28"
              data-arr="4"
            />
            <text x="133" y="63" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">4e</text>

            <!-- Caluire (NE) -->
            <polygon
              class="arr-path"
              points="165,25 240,35 245,90 175,95 170,85"
              fill="#10b98122"
              data-arr="caluire"
            />
            <text x="205" y="63" fill="#10b981" font-size="10" font-weight="600" text-anchor="middle">Caluire</text>

            <!-- Arr 5 (W) — Vieux-Lyon -->
            <polygon
              class="arr-path"
              points="20,90 65,100 70,175 25,185 15,140"
              fill="#0066ff22"
              data-arr="5"
            />
            <text x="45" y="142" fill="#0066ff" font-size="11" font-weight="700" text-anchor="middle">5e</text>

            <!-- Arr 1 (Centre-N) — Presqu'île nord -->
            <polygon
              class="arr-path"
              points="100,90 130,100 140,150 110,160 95,130"
              fill="#00e5ff30"
              data-arr="1"
            />
            <text x="118" y="128" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">1e</text>

            <!-- Arr 6 (Centre-E) -->
            <polygon
              class="arr-path"
              points="140,85 175,95 185,150 145,155 140,150"
              fill="#00e5ff28"
              data-arr="6"
            />
            <text x="163" y="125" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">6e</text>

            <!-- Villeurbanne (E) -->
            <polygon
              class="arr-path"
              points="175,95 245,90 255,165 185,170 185,150"
              fill="#0066ff28"
              data-arr="villeurbanne"
            />
            <text x="218" y="135" fill="#0066ff" font-size="10" font-weight="600" text-anchor="middle">Villeurbanne</text>

            <!-- Arr 2 (Centre-SW) -->
            <polygon
              class="arr-path"
              points="85,165 110,160 120,215 90,225 75,195"
              fill="#00e5ff22"
              data-arr="2"
            />
            <text x="97" y="195" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">2e</text>

            <!-- Arr 3 (E-centre) -->
            <polygon
              class="arr-path"
              points="140,155 185,150 190,215 145,225 130,215"
              fill="#00e5ff28"
              data-arr="3"
            />
            <text x="163" y="190" fill="#00e5ff" font-size="11" font-weight="700" text-anchor="middle">3e</text>

            <!-- Bron (E) -->
            <polygon
              class="arr-path"
              points="185,170 255,165 260,235 190,240 185,215"
              fill="#10b98120"
              data-arr="bron"
            />
            <text x="224" y="205" fill="#10b981" font-size="10" font-weight="600" text-anchor="middle">Bron</text>

            <!-- Arr 7 (S-centre) -->
            <polygon
              class="arr-path"
              points="90,225 145,225 150,295 95,300 80,265"
              fill="#0066ff22"
              data-arr="7"
            />
            <text x="117" y="263" fill="#0066ff" font-size="11" font-weight="700" text-anchor="middle">7e</text>

            <!-- Arr 8 (SE) -->
            <polygon
              class="arr-path"
              points="145,225 190,240 200,305 150,310 150,295"
              fill="#0066ff25"
              data-arr="8"
            />
            <text x="170" y="273" fill="#0066ff" font-size="11" font-weight="700" text-anchor="middle">8e</text>

            <!-- Vénissieux (S) -->
            <polygon
              class="arr-path"
              points="150,295 200,305 205,350 145,355 140,320"
              fill="#10b98120"
              data-arr="venissieux"
            />
            <text x="175" y="330" fill="#10b981" font-size="10" font-weight="600" text-anchor="middle">Vénissieux</text>

            <!-- Rivière Rhône (stylisée) -->
            <path
              d="M 175,30 C 180,80 185,130 185,170 C 185,210 185,250 190,310"
              stroke="rgba(0,229,255,0.25)"
              stroke-width="4"
              stroke-linecap="round"
              fill="none"
            />
            <!-- Rivière Saône -->
            <path
              d="M 85,40 C 88,90 90,140 95,180 C 98,210 92,250 90,300"
              stroke="rgba(0,229,255,0.15)"
              stroke-width="3"
              stroke-linecap="round"
              fill="none"
            />

            <!-- Légende -->
            <rect x="10" y="345" width="12" height="8" rx="2" fill="#00e5ff40"/>
            <text x="26" y="354" fill="rgba(255,255,255,0.5)" font-size="9">Zone principale</text>
            <rect x="130" y="345" width="12" height="8" rx="2" fill="#10b98130"/>
            <text x="146" y="354" fill="rgba(255,255,255,0.5)" font-size="9">Zone étendue</text>
          </svg>

          <div class="flex items-center justify-center gap-3 mt-3">
            <span class="dot-pulse"></span>
            <span style="font-size: 0.8125rem; color: rgba(255,255,255,0.5);">Zone couverte 24h/7j</span>
          </div>
        </div>
      </div>

      <!-- Grid zones -->
      <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-4">
        {zones.map((zone) => (
          <div class="zone-card">
            <div class="flex items-start justify-between mb-3">
              <h3 style="font-size: 1rem; font-weight: 700; color: #ffffff;">{zone.name}</h3>
              <span
                style={`font-size: 0.8125rem; font-weight: 700; background: ${zone.color}20; color: ${zone.color}; padding: 0.25rem 0.625rem; border-radius: 9999px; white-space: nowrap; border: 1px solid ${zone.color}30;`}
              >
                {zone.time}
              </span>
            </div>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {zone.services.map((s) => (
                <span class="tag tag-cyan" style={`background: ${zone.color}12; color: ${zone.color}; border-color: ${zone.color}25; font-size: 0.7rem;`}>
                  {s}
                </span>
              ))}
            </div>
            <a
              href="tel:0478001122"
              style={`display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; font-weight: 600; color: ${zone.color}; transition: gap 0.15s;`}
            >
              Appeler maintenant
              <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Garantie bas -->
    <div
      style="margin-top: 3rem; background: rgba(0,229,255,0.08); border: 1px solid rgba(0,229,255,0.2); border-radius: 1.25rem; padding: 1.5rem 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;"
    >
      <div>
        <p style="font-size: 1rem; font-weight: 700; color: #ffffff; margin-bottom: 0.25rem;">
          ⚡ Hors zone ? Appelez-nous quand même !
        </p>
        <p style="font-size: 0.875rem; color: rgba(255,255,255,0.55);">
          Nous intervenons dans toute la métropole lyonnaise et le département du Rhône.
        </p>
      </div>
      <a href="tel:0478001122" class="btn-cta flex-shrink-0">
        04 78 00 11 22
      </a>
    </div>
  </div>
</section>

<script>
  // SVG map interactivity
  document.querySelectorAll('.arr-path').forEach((el) => {
    el.addEventListener('mouseenter', function() {
      (this as SVGElement).style.opacity = '1';
    });
  });
</script>
