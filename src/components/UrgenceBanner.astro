---
// Bandeau urgence avec gradient cyan→bleu
---

<section
  style="background: linear-gradient(135deg, #00e5ff, #0066ff); padding: 3.5rem 0; position: relative; overflow: hidden;"
>
  <!-- Background pattern -->
  <div
    style="position: absolute; inset: 0; background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 20px);"
  ></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="flex flex-col items-center gap-6">

      <!-- Icon -->
      <div style="font-size: 3rem; line-height: 1;">🚨</div>

      <!-- Title -->
      <div>
        <h2
          style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 900; color: #0a0f1e; line-height: 1.1; margin-bottom: 0.75rem;"
        >
          Urgence serrurerie à Lyon ?
        </h2>
        <p style="font-size: 1.125rem; color: rgba(10,15,30,0.75); font-weight: 500; max-width: 36rem; margin: 0 auto;">
          Disponible 24h/24 et 7j/7 — Nos serruriers interviennent en moins de 30 minutes
          dans tout le Grand Lyon.
        </p>
      </div>

      <!-- Phone number grand -->
      <a
        href="tel:0478001122"
        style="font-size: clamp(2rem, 5vw, 3rem); font-weight: 900; color: #0a0f1e; text-decoration: none; transition: transform 0.2s; display: inline-block; line-height: 1;"
        onmouseover="this.style.transform='scale(1.05)';"
        onmouseout="this.style.transform='scale(1)';"
      >
        📞 04 78 00 11 22
      </a>

      <!-- Badges garanties -->
      <div class="flex flex-wrap justify-center gap-3">
        {[
          "✓ Intervention garantie −30 min",
          "✓ Devis avant travaux",
          "✓ Agréé assurance",
          "✓ Pas de supplément de nuit",
        ].map((g) => (
          <div
            style="background: rgba(10,15,30,0.15); color: #0a0f1e; font-size: 0.875rem; font-weight: 600; padding: 0.5rem 1rem; border-radius: 9999px; border: 1px solid rgba(10,15,30,0.2);"
          >
            {g}
          </div>
        ))}
      </div>

      <!-- CTA outline sombre -->
      <a
        href="/contact"
        style="margin-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.5rem; background: #0a0f1e; color: #ffffff; font-weight: 700; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 9999px; transition: all 0.2s; text-decoration: none;"
        onmouseover="this.style.background='#1e2d4a'; this.style.transform='translateY(-2px)';"
        onmouseout="this.style.background='#0a0f1e'; this.style.transform='translateY(0)';"
      >
        Demander un devis gratuit
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
