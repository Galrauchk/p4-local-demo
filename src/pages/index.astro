---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import HeroSection from "../components/HeroSection.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import ZonesMap from "../components/ZonesMap.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import UrgenceBanner from "../components/UrgenceBanner.astro";
import BlogPreview from "../components/BlogPreview.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "ProSec Serrurerie",
  "url": "https://p4-local-demo.netlify.app"
};
---

<BaseLayout
  title="Serrurier agréé assurance à Lyon"
  description="ProSec Serrurerie — Serrurier agréé assurance à Lyon. Intervention rapide en moins de 30 min, 24h/7j. Ouverture de porte, blindage, remplacement serrure."
  schema={schema}
>
  <TopBar />
  <Header currentPage="/" />
  <main>
    <HeroSection />

    <!-- Section confiance / preuves sociales rapides -->
    <section style="background: #ffffff; padding: 2.5rem 0; border-bottom: 1px solid #f1f5f9;">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
          {[
            { icon: "🏅", title: "Agréé assurance habitation", sub: "Remboursement facilité" },
            { icon: "⚡", title: "Intervention −30 minutes", sub: "Tout le Grand Lyon" },
            { icon: "📜", title: "Norme NF P 25-311", sub: "Matériel certifié" },
            { icon: "💰", title: "Devis gratuit & sans engagement", sub: "Prix fixé avant travaux" },
            { icon: "⭐", title: "4.9/5 sur Google", sub: "127 avis vérifiés" },
          ].map((item) => (
            <div class="flex items-center gap-3">
              <span style="font-size: 1.5rem;">{item.icon}</span>
              <div>
                <p style="font-size: 0.9rem; font-weight: 700; color: #0a0f1e;">{item.title}</p>
                <p style="font-size: 0.8rem; color: #9ca3af;">{item.sub}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <ServicesGrid />

    <!-- Comment ça marche -->
    <section style="background: #ffffff; padding: 5rem 0;">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="section-label mb-2">Simple et rapide</p>
        <h2 class="section-title mb-12">Comment fonctionne notre intervention ?</h2>
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          {[
            { n: "1", icon: "📞", title: "Appelez-nous", desc: "Décrivez votre urgence au 04 78 00 11 22. Nous répondons 24h/7j." },
            { n: "2", icon: "📋", title: "Devis immédiat", desc: "Prix fixé par téléphone avant l'intervention, sans surprise." },
            { n: "3", icon: "🚗", title: "Intervention rapide", desc: "Notre serrurier arrive en moins de 30 minutes, avec le matériel adapté." },
            { n: "4", icon: "✅", title: "Travail garanti", desc: "Serrures certifiées, intervention agréée, facture pour votre assurance." },
          ].map((step) => (
            <div class="flex flex-col items-center gap-3 text-center">
              <div
                style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #00e5ff, #0066ff); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; position: relative; box-shadow: 0 4px 20px rgba(0,229,255,0.3);"
              >
                {step.icon}
                <div
                  style="position: absolute; top: -4px; right: -4px; width: 20px; height: 20px; background: #0a0f1e; border-radius: 50%; font-size: 0.625rem; font-weight: 800; color: #00e5ff; display: flex; align-items: center; justify-content: center;"
                >
                  {step.n}
                </div>
              </div>
              <h3 style="font-size: 1rem; font-weight: 700; color: #0a0f1e;">{step.title}</h3>
              <p style="font-size: 0.875rem; color: #6b7280; line-height: 1.6;">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <GoogleReviews />
    <ZonesMap />
    <UrgenceBanner />
    <BlogPreview />

    <!-- FAQ rapide -->
    <section style="background: #f8fafc; padding: 5rem 0;">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="section-label mb-2 text-center">Questions fréquentes</p>
        <h2 class="section-title mb-10 text-center">FAQ Serrurerie Lyon</h2>
        <div class="flex flex-col gap-4">
          {[
            {
              q: "Combien coûte l'ouverture d'une porte à Lyon ?",
              a: "Le prix d'une ouverture de porte à Lyon commence à 69€ TTC, quel que soit l'horaire (pas de supplément de nuit ou week-end). Le tarif exact est communiqué avant toute intervention."
            },
            {
              q: "Intervenez-vous la nuit et le week-end ?",
              a: "Oui, ProSec Serrurerie intervient 24h/24 et 7j/7, y compris les nuits, week-ends et jours fériés, sans supplément tarifaire."
            },
            {
              q: "Êtes-vous agréé assurance habitation ?",
              a: "Oui, ProSec est agrée par les principales compagnies d'assurance. Nous fournissons toutes les pièces nécessaires au remboursement (facture, rapport d'intervention)."
            },
            {
              q: "Quelle est votre zone d'intervention à Lyon ?",
              a: "Nous intervenons dans les 9 arrondissements de Lyon, à Villeurbanne, Caluire, Bron, Vénissieux, Saint-Priest et dans toute la métropole lyonnaise."
            },
          ].map((faq) => (
            <details
              style="background: #ffffff; border: 1px solid #e5e7eb; border-radius: 1rem; overflow: hidden;"
            >
              <summary
                style="padding: 1.25rem 1.5rem; font-size: 1rem; font-weight: 600; color: #0a0f1e; display: flex; justify-content: space-between; align-items: center; cursor: pointer; list-style: none;"
              >
                {faq.q}
                <svg class="chevron w-5 h-5 flex-shrink-0 ml-4" style="color: #00e5ff;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div style="padding: 0 1.5rem 1.25rem; font-size: 0.9375rem; color: #4b5563; line-height: 1.7;">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <StickyMobileCTA />
</BaseLayout>
