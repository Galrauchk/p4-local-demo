---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileCTA from "../components/StickyMobileCTA.astro";
---

<BaseLayout
  title="Contact — Serrurier Lyon 24h/7j"
  description="Contactez ProSec Serrurerie à Lyon. Urgence 24h/7j : 04 78 00 11 22. Devis gratuit en ligne. Intervention rapide dans tout le Grand Lyon."
>
  <TopBar />
  <Header />
  <main>

    <!-- Hero -->
    <section style="background: linear-gradient(135deg, #0a0f1e, #141c35); padding: 4rem 0;">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="badge-live inline-flex mb-5">
          <span class="dot-pulse"></span>
          <span>Disponible maintenant · Réponse immédiate</span>
        </div>
        <h1 style="font-size: clamp(2rem, 5vw, 2.75rem); font-weight: 900; color: #ffffff; margin-bottom: 1rem;">
          Contactez ProSec Serrurerie
        </h1>
        <p style="font-size: 1.125rem; color: rgba(255,255,255,0.65);">
          Pour une urgence, appelez directement. Pour un devis, remplissez le formulaire.
        </p>
      </div>
    </section>

    <!-- Infos + Formulaire -->
    <section style="background: #f8fafc; padding: 4rem 0;">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

          <!-- Informations de contact -->
          <div class="flex flex-col gap-5">

            <!-- Urgence card -->
            <div
              style="background: linear-gradient(135deg, #00e5ff, #0066ff); border-radius: 1.5rem; padding: 2rem; color: #0a0f1e;"
            >
              <h2 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.5rem;">🚨 Urgence serrurerie ?</h2>
              <p style="font-size: 0.9375rem; margin-bottom: 1.5rem; opacity: 0.8;">Appelez directement — Intervention −30 min garantie</p>
              <a
                href="tel:0478001122"
                style="display: block; text-align: center; background: #0a0f1e; color: #ffffff; font-size: 1.75rem; font-weight: 900; padding: 1rem; border-radius: 1rem; text-decoration: none; transition: background 0.2s;"
              >
                04 78 00 11 22
              </a>
              <div class="flex items-center justify-center gap-2 mt-2">
                <span class="dot-pulse"></span>
                <span style="font-size: 0.8125rem; font-weight: 600;">Disponible 24h/24 — 7j/7</span>
              </div>
            </div>

            <!-- Coordonnées -->
            <div class="card-white" style="border: 1px solid #f1f5f9; padding: 1.75rem;">
              <h3 style="font-size: 1rem; font-weight: 700; color: #0a0f1e; margin-bottom: 1.25rem;">Coordonnées</h3>
              <div class="flex flex-col gap-4">
                {[
                  { icon: "📞", label: "Téléphone", val: "04 78 00 11 22", href: "tel:0478001122" },
                  { icon: "✉️", label: "Email", val: "contact@prosec-serrurerie.fr", href: "mailto:contact@prosec-serrurerie.fr" },
                  { icon: "📍", label: "Zone d'intervention", val: "Lyon et Grand Lyon (Rhône)" },
                  { icon: "🕐", label: "Disponibilité", val: "24h/24 — 7j/7 — Jours fériés" },
                ].map((c) => (
                  <div style="display: flex; align-items: flex-start; gap: 1rem;">
                    <span style="font-size: 1.25rem; flex-shrink: 0; width: 28px; text-align: center;">{c.icon}</span>
                    <div>
                      <p style="font-size: 0.75rem; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem;">{c.label}</p>
                      {c.href ? (
                        <a href={c.href} style="font-size: 0.9375rem; font-weight: 600; color: #0066ff; text-decoration: none;">{c.val}</a>
                      ) : (
                        <p style="font-size: 0.9375rem; font-weight: 600; color: #0a0f1e;">{c.val}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Map -->
            <div style="border-radius: 1.25rem; overflow: hidden; border: 1px solid #e5e7eb; height: 220px;">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d45207.29!2d4.8357!3d45.7640!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f4ea516ae922e1%3A0x408ab2ae4bb21f0!2sLyon!5e0!3m2!1sfr!2sfr!4v1"
                width="100%"
                height="220"
                style="border: none; display: block;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
          </div>

          <!-- Formulaire devis -->
          <div class="card-white" style="border: 1px solid #f1f5f9; padding: 2.5rem;">
            <h2 style="font-size: 1.25rem; font-weight: 800; color: #0a0f1e; margin-bottom: 0.5rem;">Demande de devis gratuit</h2>
            <p style="font-size: 0.875rem; color: #6b7280; margin-bottom: 2rem;">Réponse sous 30 minutes en heures ouvrées.</p>

            <form
              style="display: flex; flex-direction: column; gap: 1.25rem;"
              id="contact-form"
            >
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Prénom *</label>
                  <input
                    type="text"
                    name="prenom"
                    required
                    placeholder="Jean"
                    style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; transition: border-color 0.15s;"
                    onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                    onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                  />
                </div>
                <div>
                  <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Nom *</label>
                  <input
                    type="text"
                    name="nom"
                    required
                    placeholder="Dupont"
                    style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; transition: border-color 0.15s;"
                    onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                    onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                  />
                </div>
              </div>

              <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Téléphone *</label>
                <input
                  type="tel"
                  name="telephone"
                  required
                  placeholder="06 12 34 56 78"
                  style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; transition: border-color 0.15s;"
                  onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                  onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                />
              </div>

              <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Service souhaité *</label>
                <select
                  name="service"
                  required
                  style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; background: #ffffff; appearance: none;"
                  onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                  onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                >
                  <option value="">Sélectionnez un service...</option>
                  <option>Ouverture de porte urgence</option>
                  <option>Remplacement de serrure</option>
                  <option>Blindage de porte</option>
                  <option>Coffre-fort</option>
                  <option>Contrôle d'accès</option>
                  <option>Vitrage d'urgence</option>
                  <option>Autre</option>
                </select>
              </div>

              <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Votre adresse (Lyon / Grand Lyon)</label>
                <input
                  type="text"
                  name="adresse"
                  placeholder="Lyon 3ème, Villeurbanne..."
                  style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; transition: border-color 0.15s;"
                  onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                  onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                />
              </div>

              <div>
                <label style="display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.5rem;">Votre message</label>
                <textarea
                  name="message"
                  rows={4}
                  placeholder="Décrivez votre besoin..."
                  style="width: 100%; border: 1px solid #e5e7eb; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; color: #0a0f1e; outline: none; transition: border-color 0.15s; resize: vertical; font-family: inherit;"
                  onfocus="this.style.borderColor='#00e5ff'; this.style.boxShadow='0 0 0 3px rgba(0,229,255,0.12)';"
                  onblur="this.style.borderColor='#e5e7eb'; this.style.boxShadow='';"
                ></textarea>
              </div>

              <button
                type="submit"
                class="btn-cta"
                style="width: 100%; justify-content: center; font-size: 1rem; padding: 1rem;"
              >
                Envoyer ma demande de devis
              </button>

              <p style="font-size: 0.75rem; color: #9ca3af; text-align: center;">
                En soumettant ce formulaire, vous acceptez d'être contacté par ProSec Serrurerie.
                Vos données ne seront jamais vendues à des tiers.
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <StickyMobileCTA />
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.textContent = '✅ Demande envoyée — Nous vous rappelons bientôt !';
    btn.style.background = '#10b981';
    btn.disabled = true;
  });
</script>
